# EnterpriseIQ Environment Configuration

# Application
APP_NAME=EnterpriseIQ
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# LLM Provider Configuration
# Supports any OpenAI-compatible provider: OpenAI, Ollama, OpenRouter, Gemini
LLM_PROVIDER=openai
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.0
MAX_OUTPUT_TOKENS=1024

# Embedding Configuration
# Options: 'sentence-transformers' (local offline) or 'openai' (remote API)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Vector Database (Qdrant)
# Leave QDRANT_URL empty to use local embedded/disk storage at ./data/qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=enterpriseiq_knowledge
QDRANT_PATH=./data/qdrant

# Cross-Encoder Reranker
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=20
FINAL_TOP_K=5

# Semantic Cache (Redis)
# If REDIS_URL is empty, in-memory semantic cache will be used for local dev
REDIS_URL=
REDIS_TTL_SECONDS=86400
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92

# LangSmith Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=EnterpriseIQ

# Ingestion & Chunking Defaults
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
MAX_FILE_SIZE_MB=25
